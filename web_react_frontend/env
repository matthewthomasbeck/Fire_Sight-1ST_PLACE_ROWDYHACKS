# Copy to .env, fill in, then restart `npm run dev`.

# Your EC2 WebSocket stream address.
VITE_STREAM_URL=ws://YOUR_EC2_PUBLIC_DNS:8765

# Sign-in, option 1: a login endpoint on your server.
# Receives POST { "username": "...", "password": "..." } as JSON.
# VITE_LOGIN_URL=http://YOUR_EC2_PUBLIC_DNS:8000/login

# Sign-in, option 2: demo credentials (used only when VITE_LOGIN_URL is not set).
# These are readable by anyone who opens the site, so use throwaway values.
VITE_DEMO_USER=rowdy
VITE_DEMO_PASSWORD=change-me
